{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchcheck:TestCase",
  "$ref": "#/$defs/TestCase",
  "$defs": {
    "Comparator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "exact"
            },
            "base64": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "base64"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "regex"
            },
            "pattern": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "pattern"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "json"
            },
            "value": {}
          },
          "required": [
            "mode",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Oracle": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "independent": {
              "type": "boolean"
            }
          },
          "required": [
            "source",
            "independent"
          ],
          "additionalProperties": false
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "stdout": {
          "$ref": "#/$defs/Comparator"
        },
        "stderr": {
          "$ref": "#/$defs/Comparator"
        }
      },
      "required": [
        "schema_version",
        "provenance",
        "exit_code",
        "stdout"
      ],
      "additionalProperties": false
    },
    "Signature": {
      "type": "object",
      "properties": {
        "error_type": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "required": [
        "error_type",
        "location",
        "key"
      ],
      "additionalProperties": false
    },
    "TestCase": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,159}$"
        },
        "category": {
          "enum": [
            "valid",
            "boundary",
            "invalid",
            "original",
            "minimized"
          ]
        },
        "input": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "input_mode": {
          "enum": [
            "stdin",
            "file",
            "argv"
          ]
        },
        "oracle": {
          "anyOf": [
            {
              "$ref": "#/$defs/Oracle"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature": {
          "anyOf": [
            {
              "$ref": "#/$defs/Signature"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "type": "string"
        },
        "regression": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "target",
        "category",
        "input",
        "sha256",
        "size",
        "input_mode",
        "oracle",
        "signature",
        "origin",
        "regression"
      ],
      "additionalProperties": false
    }
  }
}
