{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchcheck:Oracle",
  "$ref": "#/$defs/Oracle",
  "$defs": {
    "Comparator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "exact"
            },
            "base64": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "base64"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "regex"
            },
            "pattern": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "pattern"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "json"
            },
            "value": {}
          },
          "required": [
            "mode",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Oracle": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "independent": {
              "type": "boolean"
            }
          },
          "required": [
            "source",
            "independent"
          ],
          "additionalProperties": false
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "stdout": {
          "$ref": "#/$defs/Comparator"
        },
        "stderr": {
          "$ref": "#/$defs/Comparator"
        }
      },
      "required": [
        "schema_version",
        "provenance",
        "exit_code",
        "stdout"
      ],
      "additionalProperties": false
    }
  }
}
