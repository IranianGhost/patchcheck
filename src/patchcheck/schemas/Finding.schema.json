{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchcheck:Finding",
  "$ref": "#/$defs/Finding",
  "$defs": {
    "Finding": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,159}$"
        },
        "error_type": {
          "type": "string"
        },
        "detection_method": {
          "type": "string"
        },
        "confirmation": {
          "enum": [
            "confirmed",
            "fixture",
            "unknown"
          ]
        },
        "signature": {
          "anyOf": [
            {
              "$ref": "#/$defs/Signature"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replay_stability": {
          "enum": [
            "stable",
            "unstable",
            "not_run",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "Fixed",
            "Incomplete Fix",
            "New Issue",
            "Functional Regression",
            "Inconclusive"
          ]
        },
        "root_cause": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_sufficiency": {
          "enum": [
            "sufficient",
            "fixture_only",
            "insufficient"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "complete_evidence": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "id",
        "error_type",
        "detection_method",
        "confirmation",
        "signature",
        "location",
        "base_run_ids",
        "candidate_run_ids",
        "replay_stability",
        "status",
        "root_cause",
        "evidence_sufficiency",
        "evidence",
        "complete_evidence"
      ],
      "additionalProperties": false
    },
    "Signature": {
      "type": "object",
      "properties": {
        "error_type": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "required": [
        "error_type",
        "location",
        "key"
      ],
      "additionalProperties": false
    }
  }
}
